# 复制为同目录下的 .env 后按需修改；未创建 .env 时 docker-compose.yml 使用默认值
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=cloudhub_admin
MYSQL_USER=cloudhub
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# API 服务
API_PORT=3000
DB_CONNECTION_LIMIT=10
# 生产环境必须替换为随机长字符串（至少 16 位）
JWT_SECRET=cloudhub-admin-dev-secret-change-me
JWT_EXPIRES_IN=7200
# 多个来源用英文逗号分隔
CORS_ORIGIN=http://localhost:5173
