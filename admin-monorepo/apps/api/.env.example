# 服务
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL（与仓库根目录 scripts/docker-compose.yml 对应）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudhub
DB_PASSWORD=123456
DB_NAME=cloudhub_admin
DB_CONNECTION_LIMIT=10

# JWT（生产环境务必替换为随机长字符串）
JWT_SECRET=cloudhub-admin-dev-secret-change-me
JWT_EXPIRES_IN=7200

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173
