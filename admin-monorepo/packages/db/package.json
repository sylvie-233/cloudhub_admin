{
  "name": "@cloudhub/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "云枢 Admin 共享数据库层（Drizzle schema + MySQL 连接）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@cloudhub/eslint-config": "workspace:*",
    "@cloudhub/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
